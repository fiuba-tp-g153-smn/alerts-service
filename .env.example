# Alerts Service Configuration

# Application
APP_HOST_PORT=6007
APP_ENV=development
LOG_LEVEL=INFO

# Optional: Override default IGN endpoints
# COUNTRY_GEOJSON_URL=https://wms.ign.gob.ar/geoserver/ows?service=WFS&version=1.0.0&request=GetFeature&typeName=ign:pais&outputFormat=application/json
# DEPARTMENTS_GEOJSON_URL=https://wms.ign.gob.ar/geoserver/ows?service=WFS&version=1.0.0&request=GetFeature&typeName=ign:departamento&outputFormat=application/json
# PROVINCES_GEOJSON_URL=https://wms.ign.gob.ar/geoserver/ows?service=WFS&version=1.0.0&request=GetFeature&typeName=ign:provincia&outputFormat=application/json

# S3 / object storage (for geojson backup and restore)
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_SECURE=true

# Path to the settings JSON file
SETTINGS_FILE=/config/settings.json

# Layer refresh schedule (cron expression, default: every Sunday at 3 AM UTC)
LAYER_UPDATE_CRON=0 3 * * 0

# MySQL Database
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=aviso_gempak
MYSQL_USER=avisos
MYSQL_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Alert Generation
OUTPUT_DIR=/app/output/alerts
ALERT_CACHE_DIR=/app/cache
